<html lang="en">
<head>
	<meta charset="utf-8" />
	<link rel="icon" type="image/jpeg" href="/images/favicon.jpeg" />
	<meta name="viewport" content="width=device-width, initial-scale=1.0" />
	<meta name="robots" content="noindex, nofollow" />
	<link rel="preconnect" href="https://fonts.googleapis.com">
	<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
	<link href="https://fonts.googleapis.com/css2?family=Open+Sans:wght@400;600;700;800&display=swap" rel="stylesheet">
	<title>Check Eligibility — Burial Benefit</title>
	<style>
		* { margin: 0; padding: 0; box-sizing: border-box; }

		body {
			font-family: 'Open Sans', Arial, sans-serif;
			background: #eef2f7;
			color: #111;
			min-height: 100vh;
			display: flex;
			flex-direction: column;
		}

		.page-wrap {
			flex: 1;
			max-width: 780px;
			margin: 0 auto;
			width: 100%;
			padding: 32px 20px 48px;
			text-align: center;
		}

		.headline {
			font-size: clamp(1.05rem, 3.5vw, 1.3rem);
			font-weight: 800;
			color: #111;
			margin-bottom: 20px;
			line-height: 1.4;
		}

		.divider {
			border: none;
			border-top: 1px solid #c8d4e0;
			margin: 0 0 22px;
		}

		.support-text {
			font-size: 1rem;
			color: #333;
			margin-bottom: 4px;
		}

		.elig-label {
			font-size: 1rem;
			font-weight: 700;
			color: #111;
			margin-bottom: 2px;
		}

		.benefit-amount {
			font-size: clamp(2rem, 7vw, 2.8rem);
			font-weight: 800;
			color: #111;
			margin-bottom: 28px;
			line-height: 1.2;
		}

		.benefit-amount .highlight {
			background: #ffff00;
			padding: 0 4px;
		}

		.age-question {
			font-size: clamp(1rem, 3.5vw, 1.15rem);
			font-weight: 700;
			color: #111;
			margin-bottom: 16px;
		}

		.age-btn {
			display: block;
			width: 100%;
			max-width: 580px;
			margin: 0 auto 12px;
			padding: 18px 20px;
			font-family: 'Open Sans', Arial, sans-serif;
			font-size: 1.1rem;
			font-weight: 700;
			background: #3d3b8e;
			color: #fff;
			border: none;
			border-radius: 50px;
			cursor: pointer;
			text-decoration: none;
			transition: background 0.15s, transform 0.1s;
		}

		.age-btn:last-of-type { margin-bottom: 0; }

		.age-btn:hover, .age-btn:active {
			background: #2e2c6e;
			transform: translateY(-1px);
		}

		.review-wrap {
			margin: 32px auto 0;
			max-width: 580px;
		}

		.review-card {
			background: #cde8f5;
			border-radius: 12px;
			padding: 22px 24px;
			transition: opacity 0.4s ease;
		}

		.stars {
			font-size: 1.3rem;
			margin-bottom: 10px;
		}

		.review-text {
			font-size: clamp(0.95rem, 3vw, 1.05rem);
			color: #111;
			margin-bottom: 8px;
			line-height: 1.5;
		}

		.review-author {
			font-size: 0.9rem;
			color: #555;
		}

		footer {
			text-align: center;
			padding: 16px 16px 20px;
			font-size: 0.78rem;
			color: #888;
			border-top: 1px solid #dde4ee;
		}

		footer a {
			color: #555;
			text-decoration: underline;
			margin: 0 8px;
		}

		footer p { margin-top: 6px; }

		.site-header {
			background: #fff;
			border-bottom: 1px solid #dde4ee;
			padding: 12px 24px;
		}

		.header-inner {
			max-width: 780px;
			margin: 0 auto;
			display: flex;
			justify-content: flex-end;
			align-items: center;
		}

		.phone-link {
			display: block;
			font-size: 1.25rem;
			font-weight: 800;
			color: #3d3b8e;
			text-decoration: none;
			text-align: right;
		}

		.phone-hours {
			font-size: 0.8rem;
			color: #666;
			margin-top: 2px;
			text-align: right;
		}

		.green-dot { color: #3a9b3a; }
	</style>

