<html lang="en">
<head>
	<meta charset="utf-8" />
	<link rel="icon" type="image/jpeg" href="/images/favicon.jpeg" />
	<meta name="viewport" content="width=device-width, initial-scale=1.0" />
	<meta name="robots" content="noindex, nofollow" />
	<link rel="preconnect" href="https://fonts.googleapis.com">
	<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
	<link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;700;800&display=swap" rel="stylesheet">
	<title>Check Eligibility — Burial Benefit</title>
	<style>
		* { margin: 0; padding: 0; box-sizing: border-box; }

		body {
			font-family: 'Outfit', Arial, sans-serif;
			background: #ffffff;
			color: #111;
			text-align: center;
			min-height: 100vh;
			display: flex;
			flex-direction: column;
		}

		.banner-wrap {
			width: 100%;
			background: #ffffff;
		}

		.banner-wrap img {
			width: calc(100% - 32px);
			max-width: 720px;
			display: block;
			margin: 16px auto;
		}

		.elig-heading {
			padding: 22px 20px 0;
		}

		.elig-small {
			font-size: clamp(0.95rem, 3vw, 1.1rem);
			font-weight: 500;
			color: #333;
			margin-bottom: 4px;
		}

		.elig-amount {
			font-size: clamp(2.4rem, 8vw, 3.2rem);
			font-weight: 800;
			color: #111;
			line-height: 1.1;
			margin-bottom: 2px;
		}

		.elig-amount .yellow-hl {
			background: #ffff00;
			padding: 0 6px;
		}

		.elig-plan {
			font-size: clamp(1.6rem, 5.5vw, 2.2rem);
			font-weight: 800;
			color: #111;
			margin-bottom: 0;
		}

		.age-card {
			margin: 24px auto 0;
			max-width: 420px;
			width: calc(100% - 32px);
			background: linear-gradient(160deg, #d6eaf8 0%, #e8f4fc 60%, #cde4f5 100%);
			border-radius: 18px;
			padding: 24px 20px 28px;
		}

		.age-heading {
			font-size: clamp(1.3rem, 5vw, 1.6rem);
			font-weight: 800;
			color: #111;
			margin-bottom: 20px;
		}

		.age-btn {
			display: block;
			width: 100%;
			margin: 0 auto 12px;
			padding: 16px;
			font-family: 'Outfit', Arial, sans-serif;
			font-size: 1.15rem;
			font-weight: 700;
			background: #5b9fd4;
			color: #fff;
			border: none;
			border-radius: 8px;
			cursor: pointer;
			text-decoration: none;
			transition: background 0.15s, transform 0.1s;
		}

		.age-btn:last-child { margin-bottom: 0; }

		.age-btn:hover, .age-btn:active {
			background: #3a7fbf;
			transform: translateY(-1px);
		}

		.main {
			flex: 1;
			padding-bottom: 32px;
		}

		footer {
			padding: 16px 16px 20px;
			font-size: 0.75rem;
			color: #aaa;
			border-top: 1px solid #eee;
		}

		footer a {
			color: #aaa;
			text-decoration: underline;
			margin: 0 6px;
		}

		footer p { margin-top: 6px; }
	</style>

