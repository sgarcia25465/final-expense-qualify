<body>

<header>
	<h1>Assisted Benefits</h1>
</header>

<div class="banner-wrap">
	<img src="/images/socialsecurity.png" alt="Burial Coverage Benefit" />
</div>

<div class="main">
	<h2>Check Eligibility for a $40,000 Burial Plan</h2>
	<p class="age-label">Select your age</p>
	<a href="/congratulations" class="age-btn">50 – 75</a>
	<a href="/congratulations" class="age-btn">76 – 80</a>
	<a href="/congratulations" class="age-btn">81+</a>
</div>

<footer>
	<a href="/privacy">Privacy Policy</a> &middot; <a href="/terms">Terms of Use</a>
	<p>Copyright &copy; 2026 &mdash; All rights reserved.</p>
</footer>

</body>
