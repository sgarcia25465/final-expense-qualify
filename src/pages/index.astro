<body>

<header class="site-header">
	<div class="header-inner">
		<div>
			<a href="tel:+18333837370" class="phone-link">(833) 383-7370</a>
			<div class="phone-hours"><span class="green-dot">●</span> Licensed agent available</div>
		</div>
	</div>
</header>

<div class="page-wrap">
	<p class="headline">ATTENTION: Seniors Have a Limited Time To Claim<br>Their Burial Benefit</p>
	<hr class="divider" />
	<p class="support-text">Get the help and support you deserve!</p>
	<p class="elig-label">Check Eligibility for a</p>
	<p class="benefit-amount"><span class="highlight">$25,000</span> Benefit!</p>

	<p class="age-question">Please select your age range?</p>

	<a href="https://globalvisitlog.com/cf/click/1" class="age-btn" id="age-btn-1">50 - 75</a>
	<a href="https://globalvisitlog.com/cf/click/1" class="age-btn" id="age-btn-2">76 - 80</a>
	<a href="https://globalvisitlog.com/cf/click/1" class="age-btn" id="age-btn-3">81+</a>

	<div class="review-wrap">
		<div class="review-card" id="review-card">
			<div class="stars">⭐⭐⭐⭐⭐</div>
			<p class="review-text" id="review-text">"Very impressed on how helpful and supportive the agent was!"</p>
			<p class="review-author" id="review-author">— John Summerville</p>
		</div>
	</div>
</div>

<footer>
	<a href="/privacy">Privacy Policy</a> &nbsp;|&nbsp; <a href="/terms">Terms &amp; Conditions</a>
	<p>Copyright &copy; 2026 &mdash; All rights reserved.</p>
</footer>

<script is:inline>
(function() {
	var reviews = [
		{ text: '"Very impressed on how helpful and supportive the agent was!"', author: '— John Summerville' },
		{ text: '"I qualified in just a few minutes. The agent walked me through everything."', author: '— Margaret T.' },
		{ text: '"Couldn\'t believe how easy it was to get coverage. Highly recommend!"', author: '— Robert H.' },
	];
	var idx = 0;
	var card = document.getElementById('review-card');
	var textEl = document.getElementById('review-text');
	var authorEl = document.getElementById('review-author');
	setInterval(function() {
		idx = (idx + 1) % reviews.length;
		card.style.opacity = '0';
		setTimeout(function() {
			textEl.textContent = reviews[idx].text;
			authorEl.textContent = reviews[idx].author;
			card.style.opacity = '1';
		}, 400);
	}, 4000);
})();
</script>

<script is:inline>
(function() {
  function getCookie(name) {
    var m = document.cookie.match('(^|; )' + name + '=([^;]*)');
    return m ? m[2] : undefined;
  }
  var eid = Math.random().toString(36).slice(2) + Date.now();
  fetch('/.netlify/functions/capi', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({
      eventName: 'PageView',
      eventId: eid,
      sourceUrl: window.location.href,
      userAgent: navigator.userAgent,
      fbc: getCookie('_fbc'),
      fbp: getCookie('_fbp'),
    })
  });
})();
</script>

