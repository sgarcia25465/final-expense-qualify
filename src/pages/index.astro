<body>

<div class="banner-wrap">
	<img src="/images/socialsecurity.png" alt="Burial Coverage Benefit" />
</div>

<div class="main">
	<div class="elig-heading">
		<p class="elig-small">Check Eligibility for a</p>
		<p class="elig-amount"><span class="yellow-hl">$40,000</span></p>
		<p class="elig-plan">Burial Plan</p>
	</div>

	<div class="age-card">
		<h2 class="age-heading">Select Your Age Range</h2>
		<a href="/congratulations" class="age-btn" id="age-btn-1">50-75</a>
		<a href="/congratulations" class="age-btn" id="age-btn-2">76-80</a>
		<a href="/congratulations" class="age-btn" id="age-btn-3">81+</a>
	</div>
</div>

<footer>
	<a href="/privacy">Privacy Policy</a> &middot; <a href="/terms">Terms of Use</a>
	<p>Copyright &copy; 2026 &mdash; All rights reserved.</p>
</footer>

</body>
</html>
