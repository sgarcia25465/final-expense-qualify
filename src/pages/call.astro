<html lang="en">
<head>
	<meta charset="utf-8" />
	<link rel="icon" type="image/jpeg" href="/images/favicon.jpeg" />
	<meta name="viewport" content="width=device-width, initial-scale=1.0" />
	<meta name="robots" content="noindex, nofollow" />
	<link rel="preconnect" href="https://fonts.googleapis.com">
	<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
	<link href="https://fonts.googleapis.com/css2?family=Open+Sans:wght@400;600;700;800&display=swap" rel="stylesheet">
	<title>Claim Your Burial Benefit — Call Now</title>
	<style>
		* { margin: 0; padding: 0; box-sizing: border-box; }

		body {
			font-family: 'Open Sans', Arial, sans-serif;
			background: #eef2f7;
			color: #111;
			min-height: 100vh;
			display: flex;
			flex-direction: column;
		}

		.page-wrap {
			flex: 1;
			max-width: 780px;
			margin: 0 auto;
			width: 100%;
			padding: 32px 20px 48px;
			text-align: center;
		}

		.headline {
			font-size: clamp(1.05rem, 3.5vw, 1.3rem);
			font-weight: 800;
			color: #111;
			margin-bottom: 20px;
			line-height: 1.4;
		}

		.divider {
			border: none;
			border-top: 1px solid #c8d4e0;
			margin: 0 0 22px;
		}

		.support-text {
			font-size: 1rem;
			color: #333;
			margin-bottom: 4px;
		}

		.elig-label {
			font-size: 1rem;
			font-weight: 700;
			color: #111;
			margin-bottom: 2px;
		}

		.benefit-amount {
			font-size: clamp(2rem, 7vw, 2.8rem);
			font-weight: 800;
			color: #111;
			margin-bottom: 24px;
			line-height: 1.2;
		}

		.benefit-amount .highlight {
			background: #ffff00;
			padding: 0 4px;
		}

		.congrats-card {
			background: #fff;
			border: 1px solid #dde4ee;
			border-radius: 8px;
			padding: 28px 24px 24px;
			margin: 0 auto 28px;
			max-width: 580px;
		}

		.congrats-title {
			font-size: clamp(1.4rem, 5vw, 1.8rem);
			font-weight: 800;
			color: #111;
			margin-bottom: 14px;
		}

		.congrats-msg {
			font-size: clamp(0.95rem, 3vw, 1.05rem);
			color: #111;
			margin-bottom: 16px;
			line-height: 1.6;
		}

		.congrats-msg .yellow-hl {
			background: #ffff00;
			font-weight: 700;
			font-style: italic;
		}

		.congrats-msg .red-bold {
			color: #cc0000;
			font-weight: 800;
		}

		.tap-msg {
			font-size: clamp(0.95rem, 3vw, 1rem);
			font-weight: 700;
			color: #111;
			margin-bottom: 16px;
		}

		.call-btn {
			display: block;
			width: 100%;
			max-width: 400px;
			margin: 0 auto 16px;
			padding: 18px 20px;
			font-family: 'Open Sans', Arial, sans-serif;
			font-size: clamp(1rem, 3.5vw, 1.2rem);
			font-weight: 800;
			background: #3a9b3a;
			color: #fff;
			border: none;
			border-radius: 6px;
			cursor: pointer;
			text-decoration: none;
			transition: background 0.15s, transform 0.1s;
		}

		.call-btn:hover, .call-btn:active {
			background: #2d7a2d;
			transform: translateY(-1px);
		}

		.no-hold {
			font-size: 0.95rem;
			color: #111;
		}

		.no-hold .note-label {
			color: #cc0000;
			font-weight: 800;
		}

		.review-wrap {
			max-width: 580px;
			margin: 0 auto;
		}

		.review-card {
			background: #cde8f5;
			border-radius: 12px;
			padding: 22px 24px;
			transition: opacity 0.4s ease;
		}

		.stars {
			font-size: 1.3rem;
			margin-bottom: 10px;
		}

		.review-text {
			font-size: clamp(0.95rem, 3vw, 1.05rem);
			color: #111;
			margin-bottom: 8px;
			line-height: 1.5;
		}

		.review-author {
			font-size: 0.9rem;
			color: #555;
		}

		footer {
			text-align: center;
			padding: 16px 16px 20px;
			font-size: 0.78rem;
			color: #888;
			border-top: 1px solid #dde4ee;
		}

		footer a {
			color: #555;
			text-decoration: underline;
			margin: 0 8px;
		}

		footer p { margin-top: 6px; }
	</style>

	<!-- Meta Pixel Code -->
	<script is:inline>
	!function(f,b,e,v,n,t,s)
	{if(f.fbq)return;n=f.fbq=function(){n.callMethod?
	n.callMethod.apply(n,arguments):n.queue.push(arguments)};
	if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
	n.queue=[];t=b.createElement(e);t.async=!0;
	t.src=v;s=b.getElementsByTagName(e)[0];
	s.parentNode.insertBefore(t,s)}(window, document,'script',
	'https://connect.facebook.net/en_US/fbevents.js');
	fbq('init', '1706022430363404');
	var _pveid = Math.random().toString(36).slice(2) + Date.now();
	fbq('track', 'PageView', {}, {eventID: _pveid});
	</script>
	<noscript><img height="1" width="1" style="display:none"
	src="https://www.facebook.com/tr?id=1706022430363404&ev=PageView&noscript=1"
	/></noscript>
	<!-- End Meta Pixel Code -->

	<!-- Microsoft Clarity -->
	<script type="text/javascript" is:inline>
	(function(c,l,a,r,i,t,y){
		c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
		t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
		y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
	})(window, document, "clarity", "script", "vwfcrhuuaz");
	</script>
	<!-- End Microsoft Clarity -->
</head>
<body>

<div class="page-wrap">
	<p class="headline">ATTENTION: Seniors Have a Limited Time To Claim<br>Their Burial Benefit</p>
	<hr class="divider" />
	<p class="support-text">Get the help and support you deserve!</p>
	<p class="elig-label">Check Eligibility for a</p>
	<p class="benefit-amount"><span class="highlight">$25,000</span> Benefit!</p>

	<div class="congrats-card">
		<p class="congrats-title">Congratulations!</p>
		<p class="congrats-msg">Make a quick <span class="yellow-hl">2-minute phone call</span> to claim your <span class="red-bold">$25,000 BURIAL BENEFIT!</span></p>
		<p class="tap-msg">Tap below to speak with a benefits specialist</p>
		<a href="tel:+18333837370" class="call-btn" id="call-btn" onclick="trackContact()">Call Now (833) 383-7370</a>
		<p class="no-hold"><span class="note-label">NOTE:</span> Currently no hold time</p>
	</div>

	<div class="review-wrap">
		<div class="review-card" id="review-card">
			<div class="stars">⭐⭐⭐⭐⭐</div>
			<p class="review-text" id="review-text">"The process was very quick and easy. My husband claimed it also."</p>
			<p class="review-author" id="review-author">— Jane Davis</p>
		</div>
	</div>
</div>

<footer>
	<a href="/privacy">Privacy Policy</a> &nbsp;|&nbsp; <a href="/terms">Terms &amp; Conditions</a>
	<p>Copyright &copy; 2026 &mdash; All rights reserved.</p>
</footer>

<script is:inline>
(function() {
	var reviews = [
		{ text: '"The process was very quick and easy. My husband claimed it also."', author: '— Jane Davis' },
		{ text: '"Very impressed on how helpful and supportive the agent was!"', author: '— John Summerville' },
		{ text: '"I got my coverage set up in under 10 minutes. Amazing service!"', author: '— Patricia M.' },
	];
	var idx = 0;
	var card = document.getElementById('review-card');
	var textEl = document.getElementById('review-text');
	var authorEl = document.getElementById('review-author');
	setInterval(function() {
		idx = (idx + 1) % reviews.length;
		card.style.opacity = '0';
		setTimeout(function() {
			textEl.textContent = reviews[idx].text;
			authorEl.textContent = reviews[idx].author;
			card.style.opacity = '1';
		}, 400);
	}, 4000);
})();
</script>

<script is:inline>
(function() {
	function getCookie(name) {
		var m = document.cookie.match('(^|; )' + name + '=([^;]*)');
		return m ? m[2] : undefined;
	}
	var url = window.location.href;
	var ua = navigator.userAgent;
	var fbc = getCookie('_fbc');
	var fbp = getCookie('_fbp');
	var pveid = Math.random().toString(36).slice(2) + Date.now();

	function send(eventName, eventId) {
		fetch('/.netlify/functions/capi', {
			method: 'POST',
			headers: { 'Content-Type': 'application/json' },
			body: JSON.stringify({ eventName: eventName, eventId: eventId, sourceUrl: url, userAgent: ua, fbc: fbc, fbp: fbp })
		});
	}

	send('PageView', pveid);

	window.trackContact = function() {
		var ceid = Math.random().toString(36).slice(2) + Date.now() + 'c';
		if (typeof fbq === 'function') fbq('track', 'Contact', {}, {eventID: ceid});
		send('Contact', ceid);
	};
})();
</script>

</body>
</html>
