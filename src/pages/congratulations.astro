<html lang="en">
<head>
	<meta charset="utf-8" />
	<link rel="icon" type="image/jpeg" href="/images/favicon.jpeg" />
	<meta name="viewport" content="width=device-width, initial-scale=1.0" />
	<meta name="robots" content="noindex, nofollow" />
	<link rel="preconnect" href="https://fonts.googleapis.com">
	<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
	<link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;700;800&display=swap" rel="stylesheet">
	<title>Congratulations — Burial Benefit</title>
	<style>
		* { margin: 0; padding: 0; box-sizing: border-box; }

		body {
			font-family: 'Outfit', Arial, sans-serif;
			background: #ffffff;
			color: #111;
			text-align: center;
			min-height: 100vh;
			display: flex;
			flex-direction: column;
		}

		header {
			padding: 14px 16px;
			border-bottom: 1px solid #e0e0e0;
			background: #fff;
		}

		header h1 {
			font-size: 1.35rem;
			font-weight: 800;
			color: #111;
			letter-spacing: -0.02em;
		}

		.content {
			flex: 1;
			padding: 40px 24px 40px;
			max-width: 600px;
			margin: 0 auto;
			width: 100%;
		}

		.congrats-heading {
			font-size: clamp(2rem, 7vw, 2.8rem);
			font-weight: 800;
			color: #111;
			margin-bottom: 18px;
		}

		.main-msg {
			font-size: clamp(1rem, 3.5vw, 1.25rem);
			font-weight: 500;
			color: #111;
			margin-bottom: 14px;
			line-height: 1.5;
		}

		.main-msg .highlight-call {
			font-style: italic;
			font-weight: 700;
			background: #ffff00;
			padding: 0 3px;
		}

		.main-msg .burial-red {
			font-weight: 800;
			color: #cc0000;
		}

		.urgency-msg {
			font-style: italic;
			font-size: clamp(0.95rem, 3vw, 1.05rem);
			color: #444;
			margin-bottom: 20px;
		}

		.urgency-msg .red-text {
			color: #cc0000;
		}

		.countdown {
			font-size: clamp(1.8rem, 6vw, 2.4rem);
			font-weight: 800;
			color: #cc0000;
			margin-bottom: 22px;
			letter-spacing: 0.04em;
		}

		.tap-msg {
			font-size: clamp(1rem, 3.5vw, 1.15rem);
			font-weight: 700;
			color: #111;
			margin-bottom: 18px;
		}

		.call-btn {
			display: block;
			width: 100%;
			max-width: 440px;
			margin: 0 auto 28px;
			padding: 22px 20px;
			font-family: 'Outfit', Arial, sans-serif;
			font-size: clamp(1.1rem, 4vw, 1.35rem);
			font-weight: 800;
			background: #2e7d32;
			color: #fff;
			border: none;
			border-radius: 10px;
			cursor: pointer;
			text-decoration: none;
			transition: background 0.15s, transform 0.1s;
			box-shadow: 0 6px 18px rgba(46,125,50,0.35);
		}

		.call-btn:hover, .call-btn:active {
			background: #1b5e20;
			transform: translateY(-1px);
		}

		.social-proof {
			display: flex;
			align-items: flex-start;
			gap: 10px;
			max-width: 440px;
			margin: 0 auto;
			text-align: left;
		}

		.bubble-icon {
			font-size: 1.4rem;
			flex-shrink: 0;
			margin-top: 2px;
			color: #555;
		}

		.proof-text {
			background: #ffff00;
			padding: 10px 14px;
			border-radius: 6px;
			font-size: clamp(0.9rem, 3vw, 1rem);
			font-weight: 700;
			color: #111;
			line-height: 1.4;
		}

		footer {
			padding: 16px 16px 20px;
			font-size: 0.75rem;
			color: #aaa;
			border-top: 1px solid #eee;
		}

		footer a {
			color: #aaa;
			text-decoration: underline;
			margin: 0 6px;
		}

		footer p { margin-top: 6px; }
	</style>

