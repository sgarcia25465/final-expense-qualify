</head>
<body>


<div class="content">
	<h2 class="congrats-heading">Congratulations!</h2>

	<p class="main-msg">
		Make a quick <span class="highlight-call">call</span> to claim your $1/day <span class="burial-red">BURIAL BENEFIT!</span>
	</p>

	<p class="urgency-msg">
		Hurry! Secure this benefit <span class="red-text">before time runs out...</span>
	</p>

	<div class="countdown" id="countdown">03:00</div>

	<p class="tap-msg">Tap below to get your burial benefit 👇</p>

	<a href="tel:+18336244691" class="call-btn">Call Now (833) 624-4691</a>

	<div class="social-proof">
		<span class="bubble-icon">💬</span>
		<div class="proof-text">Mary got a $20,000 final expense benefit for $1/day in just 15 minutes.</div>
	</div>
</div>

<footer>
	<a href="/privacidad">Privacy Policy</a> &middot; <a href="/terminos">Terms of Use</a>
	<p>Copyright &copy; 2026 &mdash; All rights reserved.</p>
</footer>

<script is:inline>
	(function () {
		var total = 180;
		var el = document.getElementById('countdown');

		function fmt(s) {
			var m = Math.floor(s / 60);
			var sec = s % 60;
			return (m < 10 ? '0' : '') + m + ':' + (sec < 10 ? '0' : '') + sec;
		}

		var iv = setInterval(function () {
			total--;
			if (total <= 0) {
				el.textContent = '00:00';
				clearInterval(iv);
				return;
			}
			el.textContent = fmt(total);
		}, 1000);
	})();
</script>

</body>
</html>
